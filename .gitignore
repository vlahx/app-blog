.venv/
venv/
__pycache__/
*.pyc
.DS_Store
*.swp

# Baza de date (se creează automat la inițializare)
db/
*.db
*.sqlite
*.sqlite3

# Zona de plugin-uri (gestionate separat)
plugins/*
!plugins/.gitkeep

# Fără nicio poză sau fișier media (static/images și static/uploads)
static/images/*
!static/images/.gitkeep
static/uploads/*
!static/uploads/.gitkeep
