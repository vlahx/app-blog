# URL public (https + domeniu, fără slash final). Setat per container / Caddy — NU din panoul admin.
# Folosit la og:url, TinyMCE, link-uri canonice.
# PUBLIC_SITE_URL=https://exemplu.tld

# Nume afișat (navbar, footer, SEO). Poate fi suprascris din Admin → Setări.
# SITE_DISPLAY_NAME=Blogul meu
# SITE_TAGLINE=Subtitlu scurt pentru hero și footer.

# Icon navbar + hero (opțional). Gol → SVG camion în template. Poate fi setat din Admin → Setări.
# SITE_NAV_ICON_PATH=/static/images/site_uploads/exemplu.png

# Link fix în navbar (opțional): din editor. Opțional din .env:
# NAV_FIXED_POST_SLUG=despre
# NAV_FIXED_POST_LABEL=Despre noi

# Articole la rădăcină /slug în loc de /blog/slug (sau din Admin → Setări → URL-uri articole).
# FLAT_POST_URLS=true

# Tema activă (folder în `themes/<nume>/templates`). Implicit: default (adică `templates/`).
# ACTIVE_THEME=minimal
# ACTIVE_THEME=default

# og:image / twitter:image — PNG sau JPEG static (~1200×630), fallback când articolul n-are jpg/png pe URL.
# OG_CARD_IMAGE_PATH=/static/images/og/camionagiul.png

# Upload: crop centrat + resize exact la OUTPUT_* (implicit 1200×630, raport OG). CROP_OG=false → thumbnail:
# POST_IMAGE_CROP_OG=true
# POST_IMAGE_OUTPUT_WIDTH=1200
# POST_IMAGE_OUTPUT_HEIGHT=630
# POST_IMAGE_MAX_EDGE=1920

# Session (cookies)
SESSION_SECRET=change-me-to-a-long-random-string

# Telegram login widget (poți muta aceste valori în Admin → Plugin-uri → se salvează în SQLite)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_BOT_USERNAME=YourBotUsername

# Chat ID pentru notificări bot (același token): mesaje la abonare newsletter etc. Plugin „telegram_notify”.
# TELEGRAM_NOTIFY_CHAT_ID=123456789
#
# SMTP notificări newsletter (fallback dacă nu completezi Admin → Newsletter):
# NEWSLETTER_SMTP_HOST=hosting_mailserver
# NEWSLETTER_SMTP_PORT=587
# NEWSLETTER_SMTP_USER=no-reply@exemplu.tld
# NEWSLETTER_SMTP_PASSWORD=secret
# NEWSLETTER_FROM_EMAIL=no-reply@exemplu.tld
# NEWSLETTER_FROM_NAME=Site
# NEWSLETTER_NOTIFY_EMAIL=admin@exemplu.tld
# NEWSLETTER_SMTP_TLS_VERIFY=false
# NEWSLETTER_SMTP_STARTTLS=true
#
# Debug global SMTP (toate mesajele) și cert (alternativ la NEWSLETTER_SMTP_TLS_VERIFY=false):
# SMTP_DEBUG=false
# SMTP_SKIP_TLS_VERIFY=false

# (optional) TTL for Telegram auth_date replay protection
TELEGRAM_AUTH_TTL_SECONDS=86400

# Admin → Plugin-uri: afișează butonul „Repornește containerul” (trimite SIGTERM procesului; necesită Docker cu restart: unless-stopped).
# ADMIN_ENABLE_CONTAINER_RESTART=true

