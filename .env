# -----------------------------------------------------------------------------
# .env — valori locale (nu comita în git). Exemplu documentat: .env.example
# -----------------------------------------------------------------------------

# --- Telegram (login admin) ---
TELEGRAM_BOT_TOKEN="8772679203:AAFbpgI9dFqsVWWjRhcZ4sS9zeeGOmPlnCI"
TELEGRAM_ADMIN_CHAT_ID="8158278347"
TELEGRAM_BOT_USERNAME="camionagiul_club_bot"
TELEGRAM_AUTH_TTL_SECONDS=86400
TELEGRAM_AUTH_URL="/admin/login/telegram"

# --- URL public + fallback og:image / twitter:image (~1200×630) dacă articolul n-are raster OK ---
PUBLIC_SITE_URL=https://camionagiul.club

OG_CARD_IMAGE_PATH=/static/images/og/camionagiul.png

# --- Upload /admin/upload-image --- (crop centrat 1200×630 = raport OG; CROP_OG=false → thumbnail POST_IMAGE_MAX_EDGE)
POST_IMAGE_CROP_OG=true
POST_IMAGE_OUTPUT_WIDTH=1200
POST_IMAGE_OUTPUT_HEIGHT=630
POST_IMAGE_MAX_EDGE=1920

ADMIN_ENABLE_CONTAINER_RESTART=true

# --- Session (schimbă cu un string lung random în producție) ---
SESSION_SECRET=change-me-to-a-long-random-string


NEWSLETTER_SMTP_TLS_VERIFY=false